APP_ENV=development
APP_NAME=PAI Platform
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+asyncpg://pai:pai@localhost:5432/pai
REDIS_PASSWORD=replace-with-development-redis-password
REDIS_URL=redis://:replace-with-development-redis-password@localhost:6379/0
REDIS_CACHE_URL=redis://:replace-with-development-redis-password@localhost:6379/0
REDIS_QUEUE_URL=redis://:replace-with-development-redis-password@localhost:6379/1

# Empty for direct local uvicorn; /pai for the integrated mini-app deployment.
PAI_BASE_PATH=
JWT_SIGNING_KEY=replace-with-a-long-secret
JWT_ISSUER=pai-platform
JWT_AUDIENCE=pai-platform
JWT_ACCESS_TOKEN_MINUTES=30
PAI_BOOTSTRAP_ADMIN_PASSWORD=replace-only-for-controlled-first-deployment
# Replace this placeholder only in backend/.env; never commit the local key.
PAI_INTEGRATION_API_KEY=replace-with-service-to-service-key
# JSON object of key-id -> base64url Ed25519 public key. Never put private keys here.
ACTOR_CONTEXT_PUBLIC_KEYS_JSON={"lms-key-2026-01":"replace-with-base64url-ed25519-public-key"}

OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minio
OBJECT_STORAGE_SECRET_KEY=miniosecret
OBJECT_STORAGE_BUCKET=pai-documents
OBJECT_STORAGE_SECURE=false
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_RETENTION_DAYS=30
# Production requires DOCUMENT_SCANNER=clamav. The development inspector is
# only suitable for local development and fixture tests.
DOCUMENT_SCANNER=development
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=10

MODEL_PROVIDER=local-vllm
MODEL_BASE_URL=http://localhost:4000/api/v1/generate
MODEL_API_KEY=local-token
MODEL_NAME=replace-with-approved-model
MODEL_TIMEOUT_SECONDS=200
# Validated against the current CTPAI Gateway; higher requests are rejected.
MODEL_MAX_TOKENS=131072
COURSE_GENERATION_MAX_TOKENS=65536
COURSE_GENERATION_QUALITY_VALIDATION_ENABLED=true
GENERATION_TIMEOUT_SECONDS=660
CV_JD_EXTRACTION_MAX_TOKENS=8192
# Enables full relation + section evidence extraction in the worker.
EVIDENCE_GRAPH_RUNTIME_ENABLED=false
# Debug-only locator forensics; keep disabled in normal environments.
EXTRACTION_FORENSICS_ENABLED=false
EXTRACTION_FORENSICS_DIR=/tmp/pai-extraction-forensics
MODEL_MAX_RETRIES=1
STRUCTURED_OUTPUT_REPAIR_RETRIES=1
PRIVACY_POLICY_VERSION=privacy-v1

EXTERNAL_AI_ENABLED=false
EXTERNAL_RESTRICTED_DATA_APPROVED=false

PII_EXTERNAL_DEFAULT_DENY=true
LOG_LEVEL=INFO
