# Docker Compose local-only configuration. Copy to .env and replace development
# secrets before sharing an environment with anyone else.
COMPOSE_PROJECT_NAME=pai-local

# Host ports. These defaults avoid the currently running BrainHub stack.
PAI_API_PORT=18000
PAI_POSTGRES_PORT=15433
PAI_REDIS_PORT=16379
PAI_MINIO_PORT=19000
PAI_MINIO_CONSOLE_PORT=19001

POSTGRES_DB=pai
POSTGRES_USER=pai
POSTGRES_PASSWORD=replace-with-local-pai-db-password
REDIS_PASSWORD=replace-with-local-pai-redis-password
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=replace-with-local-minio-password
