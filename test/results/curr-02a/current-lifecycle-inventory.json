    {"operation": "PREVIEW feedback", "route_or_service": "POST /api/v1/course-authoring/curriculum-plans/{plan_id}/feedback/preview", "before": "SERVICE_NOT_EXPOSED", "after": "EXISTS_PUBLIC_API"},
    {"operation": "REVISE from feedback", "route_or_service": "POST /api/v1/course-authoring/curriculum-plans/{plan_id}/feedback", "before": "SERVICE_NOT_EXPOSED", "after": "EXISTS_PUBLIC_API"},
